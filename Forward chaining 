        "# First Order Logic using Forward Chaining\n",
        "# Problem: Prove that Robert is Criminal\n",
        "\n",
        "facts = {\n",
        "    (\"American\", \"Robert\"),\n",
        "    (\"Enemy\", \"A\"),\n",
        "    (\"Owns\", \"A\", \"M1\"),\n",
        "    (\"Missile\", \"M1\")\n",
        "}\n",
        "\n",
        "# Rules represented as premises and conclusion\n",
        "rules = [\n",
        "    # Enemy(A) -> Hostile(A)\n",
        "    ([(\"Enemy\", \"?x\")], (\"Hostile\", \"?x\")),\n",
        "\n",
        "    # Missile(x) -> Weapon(x)\n",
        "    ([(\"Missile\", \"?x\")], (\"Weapon\", \"?x\")),\n",
        "\n",
        "    # Missile(y) AND Owns(A,y) -> Sells(Robert,y,A)\n",
        "    ([(\"Missile\", \"?y\"), (\"Owns\", \"A\", \"?y\")],\n",
        "     (\"Sells\", \"Robert\", \"?y\", \"A\")),\n",
        "\n",
        "    # American(x) AND Weapon(y) AND Sells(x,y,z)\n",
        "    # AND Hostile(z) -> Criminal(x)\n",
        "    ([(\"American\", \"?x\"), (\"Weapon\", \"?y\"),\n",
        "      (\"Sells\", \"?x\", \"?y\", \"?z\"),\n",
        "      (\"Hostile\", \"?z\")],\n",
        "     (\"Criminal\", \"?x\"))\n",
        "]\n",
        "\n",
        "\n",
        "# Forward Chaining Function\n",
        "def forward_chaining(facts, rules, query):\n",
        "\n",
        "    inferred = set(facts)\n",
        "\n",
        "    while True:\n",
        "        new_facts = set()\n",
        "\n",
        "        for premises, conclusion in rules:\n",
        "\n",
        "            def match(index, substitution):\n",
        "                if index == len(premises):\n",
        "                    return [substitution]\n",
        "\n",
        "                results = []\n",
        "\n",
        "                for fact in inferred:\n",
        "                    if fact[0] != premises[index][0]:\n",
        "                        continue\n",
        "\n",
        "                    if len(fact) != len(premises[index]):\n",
        "                        continue\n",
        "\n",
        "                    new_sub = substitution.copy()\n",
        "                    valid = True\n",
        "\n",
        "                    for pattern, value in zip(\n",
        "                        premises[index], fact\n",
        "                    ):\n",
        "                        if pattern.startswith(\"?\"):\n",
        "                            if pattern in new_sub:\n",
        "                                if new_sub[pattern] != value:\n",
        "                                    valid = False\n",
        "                                    break\n",
        "                            else:\n",
        "                                new_sub[pattern] = value\n",
        "                        elif pattern != value:\n",
        "                            valid = False\n",
        "                            break\n",
        "\n",
        "                    if valid:\n",
        "                        results.extend(\n",
        "                            match(index + 1, new_sub)\n",
        "                        )\n",
        "\n",
        "                return results\n",
        "\n",
        "            substitutions = match(0, {})\n",
        "\n",
        "            for sub in substitutions:\n",
        "                result = tuple(\n",
        "                    sub.get(item, item)\n",
        "                    if isinstance(item, str)\n",
        "                    else item\n",
        "                    for item in conclusion\n",
        "                )\n",
        "\n",
        "                if result not in inferred:\n",
        "                    new_facts.add(result)\n",
        "\n",
        "        if not new_facts:\n",
        "            break\n",
        "\n",
        "        print(\"\\nNew facts derived:\")\n",
        "        for fact in new_facts:\n",
        "            print(fact)\n",
        "\n",
        "        inferred.update(new_facts)\n",
        "\n",
        "    print(\"\\nFinal Result:\")\n",
        "\n",
        "    if query in inferred:\n",
        "        print(\"Query is PROVED!\")\n",
        "        print(\"Robert is a CRIMINAL.\")\n",
        "    else:\n",
        "        print(\"Query is NOT PROVED.\")\n",
        "\n",
        "\n",
        "# Query\n",
        "query = (\"Criminal\", \"Robert\")\n",
        "\n",
        "# Execute\n",
        "print(\"Initial Knowledge Base:\")\n",
        "for fact in facts:\n",
        "    print(fact)\n",
        "\n",
        "print(\"\\nApplying Forward Chaining...\")\n",
        "forward_chaining(facts, rules, query)\n"
      ]
